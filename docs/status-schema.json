{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/DecentraLabsCom/Lab-Station/main/docs/status-schema.json",
  "title": "Lab Station status document",
  "description": "Schema for status-json output and the status member of the heartbeat document.",
  "type": "object",
  "required": [
    "schemaVersion",
    "timestamp",
    "stationProfile",
    "remoteAppEnabled",
    "winrm",
    "legacyAppControlAutostart",
    "wake",
    "power",
    "readiness",
    "summary",
    "operations",
    "localSessionActive",
    "localModeEnabled"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^2\\.",
      "description": "Telemetry contract version. Current value is 2.0.0."
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "stationProfile": {"type": "string", "enum": ["server", "hybrid"]},
    "identity": {"type": "object", "additionalProperties": true},
    "remoteAppEnabled": {"type": "boolean"},
    "winrm": {"$ref": "#/definitions/object"},
    "legacyAppControlAutostart": {"type": "boolean"},
    "wake": {
      "type": "object",
      "properties": {
        "armedCount": {"type": "integer", "minimum": 0},
        "nicPower": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "power": {"$ref": "#/definitions/object"},
    "biosChecklist": {"$ref": "#/definitions/object"},
    "policy": {"$ref": "#/definitions/object"},
    "sessions": {"$ref": "#/definitions/sessionSummary"},
    "fmuExecutor": {
      "type": "object",
      "properties": {
        "available": {"type": "boolean"},
        "running": {"type": "boolean"},
        "processRunning": {"type": "boolean"},
        "pid": {"type": "integer", "minimum": 0},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "tokenConfigured": {"type": "boolean"},
        "consecutiveFailures": {"type": "integer", "minimum": 0},
        "lastHealth": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "readiness": {
      "type": "object",
      "required": ["physicalLab", "fmu"],
      "properties": {
        "physicalLab": {"$ref": "#/definitions/capabilityReadiness"},
        "fmu": {"$ref": "#/definitions/capabilityReadiness"}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["state", "ready", "issues"],
      "properties": {
        "state": {"type": "string"},
        "ready": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "operations": {"$ref": "#/definitions/object"},
    "lastForcedLogoff": {"$ref": "#/definitions/object"},
    "localSessionActive": {"type": "boolean"},
    "localModeEnabled": {"type": "boolean"}
  },
  "additionalProperties": true,
  "definitions": {
    "object": {"type": "object", "additionalProperties": true},
    "sessionSummary": {
      "type": "object",
      "properties": {
        "queryOk": {"type": "boolean"},
        "active": {"type": "boolean"},
        "kind": {
          "type": "string",
          "enum": ["none", "labuser-local", "labuser-remote", "local-user", "remote-user", "mixed", "unknown"]
        },
        "labUserActive": {"type": "boolean"},
        "labUserRemoteActive": {"type": "boolean"},
        "localUserActive": {"type": "boolean"},
        "remoteSessionActive": {"type": "boolean"},
        "entries": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": true
    },
    "capabilityReadiness": {
      "type": "object",
      "required": ["ready", "issues"],
      "properties": {
        "available": {"type": "boolean"},
        "ready": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
